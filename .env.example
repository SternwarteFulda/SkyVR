# STUN Provider
STUN_URL_1=stun:stun1.l.google.com:19302
STUN_URL_2=stun:stun2.l.google.com:19302

# TURN Provider
# Note: Each TURN_URL_X must have a corresponding TURN_USER_X and TURN_CRED_X
TURN_URL_1=turn:turn.your-provider.com:3478
TURN_USER_1=your_username_here
TURN_CRED_1=your_credential_here

TURN_URL_2=turn:turn.your-provider.com:80
TURN_USER_2=your_username_here
TURN_CRED_2=your_credential_here

TURN_URL_3=turn:turn.your-provider.com:80?transport=tcp
TURN_USER_3=your_username_here
TURN_CRED_3=your_credential_here

TURN_URL_4=turn:turn.your-provider.com:443
TURN_USER_4=your_username_here
TURN_CRED_4=your_credential_here

TURN_URL_5=turns:turn.your-provider.com:443?transport=tcp
TURN_USER_5=your_username_here
TURN_CRED_5=your_credential_here
# ... add more as needed (up to 10)

# Legal Links (Optional, displayed in footer)
IMPRINT_URL=https://example.com/imprint
PRIVACY_POLICY_URL=https://example.com/privacy
